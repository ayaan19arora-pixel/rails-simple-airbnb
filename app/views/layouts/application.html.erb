<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Simple Airbnb" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rails Simple Airbnb">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.1.2/css/all.css">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 min-h-screen">
    <nav class="bg-white shadow">
      <div class="container mx-auto px-5 py-4 flex justify-between items-center">
        <%= link_to "Rails Simple Airbnb", root_path, class: "text-xl font-bold text-gray-800" %>
        <%= link_to "Add a flat", new_flat_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
      </div>
    </nav>

    <main class="container mx-auto px-5 py-8">
      <%= yield %>
    </main>
  </body>
</html>
