<%= simple_form_for flat do |f| %>
  <%= f.input :name, input_html: { class: "w-full border border-gray-300 rounded px-3 py-2" } %>
  <%= f.input :address, input_html: { class: "w-full border border-gray-300 rounded px-3 py-2" } %>
  <%= f.input :description, as: :text, input_html: { class: "w-full border border-gray-300 rounded px-3 py-2", rows: 4 } %>
  <%= f.input :price_per_night, input_html: { class: "w-full border border-gray-300 rounded px-3 py-2" } %>
  <%= f.input :number_of_guests, input_html: { class: "w-full border border-gray-300 rounded px-3 py-2" } %>
  <%= f.button :submit, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
<% end %>
