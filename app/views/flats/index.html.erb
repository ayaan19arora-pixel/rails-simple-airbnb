<h1 class="text-3xl font-bold mb-6">Available flats</h1>

<div class="grid gap-6 md:grid-cols-3">
  <% @flats.each do |flat| %>
    <div class="bg-white rounded-lg shadow p-6 flex flex-col">
      <h2 class="text-xl font-semibold mb-2"><%= flat.name %></h2>
      <p class="text-gray-500 mb-2"><i class="fa-solid fa-location-dot"></i> <%= flat.address %></p>
      <p class="text-gray-700 mb-4">£<%= flat.price_per_night %> / night · <%= flat.number_of_guests %> guests</p>

      <div class="mt-auto flex gap-4">
        <%= link_to "See details", flat_path(flat), class: "text-blue-600 hover:underline" %>
        <%= link_to "Edit", edit_flat_path(flat), class: "text-gray-600 hover:underline" %>
        <%= link_to "Delete", flat_path(flat), data: { turbo_method: :delete, turbo_confirm: "Delete this flat?" }, class: "text-red-600 hover:underline" %>
      </div>
    </div>
  <% end %>
</div>
